# Clerk Authentication (get keys from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# Database Connection (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database

# LOINC Search API credentials (register at https://loinc.org/join)
LOINC_USERNAME=your_loinc_username
LOINC_PASSWORD=your_loinc_password

# Google Gemini API key (server-side only; obtain from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Next.js Environment
NODE_ENV=development
